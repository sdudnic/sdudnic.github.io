# Sursă de citire: local (implicit), supabase sau auto.
MOLDOVENEASCA_SOURCE=local
# Căi relative la rădăcina proiectului; mai multe căi se separă prin ; pe Windows.
MOLDOVENEASCA_CATALOG_PATHS=research-catalog.json

# Necesare pentru contribuții, moderare și citirea catalogului live.
MOLDOVENEASCA_SUPABASE_URL=https://project-ref.supabase.co
MOLDOVENEASCA_SUPABASE_ANON_KEY=sb_publishable_...
# Opțional: token JWT deja obținut. Metoda recomandată este `npm run auth:login` cu GitHub OAuth.
MOLDOVENEASCA_SUPABASE_ACCESS_TOKEN=
# Folosit numai de metoda alternativă `npm run auth:password`.
MOLDOVENEASCA_SUPABASE_EMAIL=
MOLDOVENEASCA_AUTH_SESSION_FILE=.moldoveneasca-session.json
MOLDOVENEASCA_AUTH_CALLBACK_HOST=127.0.0.1
MOLDOVENEASCA_AUTH_CALLBACK_PORT=54321
MOLDOVENEASCA_AUTH_CALLBACK_PATH=/callback
# Adaugă această adresă în Supabase Authentication > URL Configuration > Redirect URLs.
MOLDOVENEASCA_AUTH_REDIRECT_URL=http://127.0.0.1:54321/callback
MOLDOVENEASCA_PRIMARY_ADMIN_EMAIL=sdudnic@gmail.com

# Opțional: dacă este definit, protejează REST și /mcp cu X-API-Key sau Bearer.
MOLDOVENEASCA_API_KEY=
MOLDOVENEASCA_HOST=127.0.0.1
PORT=8787
